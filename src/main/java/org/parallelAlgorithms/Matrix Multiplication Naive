import java.util.*;
import java.util.concurrent.*;
class Main {
    static int[][] arr1;
    static int[][] arr2;
    static int[][] res;
    public static void main(String[] args) {
        System.out.println("Start small. Ship something.");
        int n = 3;
        arr1 = new int[][]{{0, 1, 4}, {5, 2, 2}, {4, 0, 1}};
        arr2 = new int[][]{{2, 1, 3}, {1, 0, 5}, {1, 5, 7}};
        res = new int[][]{{0,0,0},{0,0,0},{0,0,0}};
        
        
        
        
        List<Thread> threads = new ArrayList<>();
        for (int i=0; i<n; i++) {
            int row = i;
            for (int j=0; j<n; j++) {
                int col = j;
                Thread worker = new Thread(new WorkerThread(row, col));
                worker.start();
                threads.add(worker);
            }
        }
        
        try {
            for (Thread t: threads) {
                t.join();
            }
        } catch (InterruptedException e) {
            e.printStackTrace();
        }
        
    
        System.out.println(Arrays.deepToString(res));
        
    }
    
    static class WorkerThread implements Runnable {
        int row;
        int col;
        WorkerThread(int row, int col) {
            this.row = row;
            this.col = col;
        }
        
        public void run() {
            int sum = 0;
            int size = arr1.length;
            for (int i=0; i<size; i++) {
                sum += (arr1[row][i] * arr2[i][col]);
            }
            
            res[row][col] = sum;
        }
    }
}
